QOP_HOST=127.0.0.1
QOP_PORT=8787
QOP_PUBLIC_URL=https://api.qiqc-op.com
QOP_WEB_DIR=0
QOP_LEDGER_DIR=/var/lib/qop/catalog/ledger
QOP_ACTIVITY_DIR=/var/lib/qop/catalog/activity
QOP_CONTRACT_DIR=/opt/qop/current/contract
QOP_DB_PATH=/var/lib/qop/data/index.sqlite
QOP_AUTH_DB_PATH=/var/lib/qop/data/auth.sqlite
QOP_SUBMISSIONS_DB_PATH=/var/lib/qop/data/submissions.sqlite
QOP_COMMIT=1
QOP_GIT_REMOTE=origin
QOP_GIT_BRANCH=main
QOP_SYNC_INTERVAL_MS=60000
QOP_TRUST_PROXY=1
# Explicit project inbox opt-in; match site/config.json before publishing the form.
# QOP_SUBMISSIONS_MODE=basic
# QOP_SUBMISSION_ORIGINS=https://qiqc-op.com,https://www.qiqc-op.com
# QOP_SUBMISSIONS_PER_HOUR=10
# Global attempts (including failed verification), total rows, and SQLite storage ceiling.
QOP_SUBMISSIONS_GLOBAL_PER_HOUR=100
QOP_SUBMISSIONS_MAX_ROWS=10000
QOP_SUBMISSIONS_MAX_BYTES=268435456
# Optional aggregate-only monitoring key; separate from the inbox management key.
# QOP_INBOX_MONITOR_KEY_HASH=<SHA-256 of the random capacity-monitor key>
# Generate a random key with scripts/inbox-access-key.mjs; put ONLY its hash here.
# QOP_INBOX_KEY_HASH=<SHA-256 of the random inbox-only access key>
# Optional stronger protection: mode=captcha, plus the widget settings on the site.
# QOP_CAPTCHA_PROVIDER=turnstile
# QOP_CAPTCHA_SECRET=<production widget secret; never commit this value>
