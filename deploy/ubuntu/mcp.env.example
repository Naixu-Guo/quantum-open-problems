QOP_SERVICE_URL=http://127.0.0.1:8787
QOP_MCP_PORT=8788
QOP_MCP_ALLOWED_HOSTS=api.qiqc-op.com,localhost,127.0.0.1
# Comma-separated Origin hostnames, as accepted by the official SDK guard.
QOP_MCP_ALLOWED_ORIGINS=api.qiqc-op.com,qiqc-op.com,www.qiqc-op.com
# nginx must replace X-Forwarded-For with the client's address.
QOP_MCP_TRUST_PROXY=true
