{
  "name": "quantum-open-problems",
  "version": "0.2.0",
  "description": "A shared, machine-readable research layer for open problems in quantum science: canonical Git-backed catalog, static website and API, operational service for candidate updates and discussion, and an MCP adapter for AI agents.",
  "type": "module",
  "scripts": {
    "build": "node site/build.mjs",
    "validate": "node core/validate.mjs && node site/validate.mjs",
    "validate:canonical": "node core/validate.mjs",
    "test": "node --test --no-warnings=ExperimentalWarning \"tests/*.test.mjs\"",
    "site": "python3 -m http.server 8000 --directory site",
    "service": "node service/server.mjs",
    "mcp": "node mcp/server.mjs",
    "revisions": "node scripts/record-published-revisions.mjs"
  },
  "bin": {
    "quantum-open-problems-mcp": "./mcp/server.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Naixu-Guo/quantum-open-problems.git"
  },
  "license": "MIT"
}
