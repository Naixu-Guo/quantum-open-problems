{
  "name": "qiqcop-zoo",
  "version": "1.0.0",
  "private": true,
  "description": "Quantum Information and Quantum Computation Open Problem Zoo: a dependency-free static site built from JSON problem records with TeX content.",
  "type": "module",
  "scripts": {
    "build": "node site/build.mjs",
    "serve": "python3 -m http.server 8000 --directory dist",
    "import": "node scripts/import-problems.mjs",
    "sync-tex": "node scripts/sync-tex.mjs",
    "migrate-metadata": "node scripts/migrate-metadata.mjs",
    "check-metadata": "node scripts/migrate-metadata.mjs --check",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.mjs",
    "new-id": "node scripts/new-problem-id.mjs",
    "export-ledger": "node --experimental-strip-types --no-warnings scripts/export-ledger.mjs",
    "check-ledger": "node --experimental-strip-types --no-warnings scripts/export-ledger.mjs --check",
    "validate:ledger": "node --experimental-strip-types --no-warnings contract/src/cli/validate.ts ledger activity",
    "service": "npm --prefix service run serve",
    "mcp": "npm --prefix mcp start"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Naixu-Guo/quantum-open-problems.git"
  },
  "license": "MIT"
}
