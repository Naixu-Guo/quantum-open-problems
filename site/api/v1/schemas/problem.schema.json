{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naixu-guo.github.io/quantum-open-problems/schema/canonical/v0.2/problem.schema.json",
  "title": "Canonical quantum open problem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "accession",
    "aliases",
    "catalogState",
    "title",
    "proposed",
    "topicId",
    "collectionId",
    "question",
    "keywords",
    "relatedProblemIds"
  ],
  "properties": {
    "kind": {
      "const": "Problem"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "accession": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^QOP-[0-9]{4,}$"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "catalogState": {
      "enum": [
        "candidate",
        "published",
        "archived"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "titleMarkdown": {
      "type": [
        "string",
        "null"
      ],
      "description": "Title with inline TeX for typeset display; omitted or null when the plain title suffices."
    },
    "proposed": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}(?:-[0-9]{2}-[0-9]{2})?$"
    },
    "topicId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "collectionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "summary",
        "importance",
        "unresolved"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "type": "string",
          "minLength": 1
        },
        "unresolved": {
          "type": "string"
        }
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "relatedProblemIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
