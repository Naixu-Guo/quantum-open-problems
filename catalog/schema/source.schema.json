{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naixu-guo.github.io/quantum-open-problems/schema/canonical/v0.1/source.schema.json",
  "title": "Canonical research source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "title",
    "authors",
    "venue",
    "url"
  ],
  "properties": {
    "kind": { "const": "Source" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "authors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "venue": { "type": "string" },
    "url": { "type": ["string", "null"], "format": "uri" }
  }
}
