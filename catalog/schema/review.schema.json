{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naixu-guo.github.io/quantum-open-problems/schema/operational/v1/review.schema.json",
  "title": "Review submission",
  "description": "A structured review of a candidate update. Reviewers file scope, source, argument, artifact, or reproduction reviews; a human editor files the editorial review that changes the review state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidateUpdateId", "reviewType", "verdict", "summary", "references", "checks", "conflictOfInterest"],
  "properties": {
    "candidateUpdateId": { "type": "string", "pattern": "^cu-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "reviewType": { "enum": ["scope", "source", "argument", "artifact", "reproduction", "editorial"] },
    "verdict": { "enum": ["accept", "reject", "needs-revision", "inconclusive"] },
    "summary": { "type": "string", "minLength": 10, "maxLength": 8000 },
    "references": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri"],
        "properties": {
          "uri": { "type": "string", "format": "uri", "maxLength": 2000 },
          "locator": { "type": ["string", "null"], "maxLength": 500 },
          "note": { "type": ["string", "null"], "maxLength": 1000 }
        }
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 50,
      "description": "Reproduction or artifact checks performed, each with a result.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "result": { "enum": ["pass", "fail", "not-applicable"] },
          "note": { "type": ["string", "null"], "maxLength": 2000 },
          "artifactUri": { "type": ["string", "null"], "format": "uri" }
        }
      }
    },
    "conflictOfInterest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared"],
      "properties": {
        "declared": { "type": "boolean" },
        "statement": { "type": ["string", "null"], "maxLength": 1000 }
      }
    },
    "statusEffect": {
      "enum": ["none", "open", "partial", "solved"],
      "description": "Editorial reviews only: the status the accepted update should produce when promoted."
    },
    "acceptedClaim": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Editorial accept reviews only: the exact claim wording and evidence classification to promote.",
      "required": ["title", "text", "relation", "maturity", "strength", "label"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "relation": { "enum": ["supports", "narrows", "refutes", "resolves", "reformulates", "rules-out", "status-review"] },
        "maturity": { "type": "string", "minLength": 1, "maxLength": 100 },
        "strength": { "type": "string", "minLength": 1, "maxLength": 100 },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "date": { "type": ["string", "null"], "pattern": "^[0-9]{4}(?:-[0-9]{2}-[0-9]{2})?$" }
      }
    }
  }
}
