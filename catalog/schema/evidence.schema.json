{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naixu-guo.github.io/quantum-open-problems/schema/canonical/v0.1/evidence.schema.json",
  "title": "Canonical claim evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "claimId",
    "sourceId",
    "sourceLocator",
    "date",
    "maturity",
    "strength",
    "label"
  ],
  "properties": {
    "kind": { "const": "Evidence" },
    "id": { "type": "string", "minLength": 1 },
    "claimId": { "type": "string", "minLength": 1 },
    "sourceId": { "type": "string", "minLength": 1 },
    "sourceLocator": { "type": ["string", "null"] },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}(?:-[0-9]{2}-[0-9]{2})?$"
    },
    "maturity": { "type": "string", "minLength": 1 },
    "strength": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 }
  }
}
