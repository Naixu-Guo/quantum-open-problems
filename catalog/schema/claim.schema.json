{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naixu-guo.github.io/quantum-open-problems/schema/canonical/v0.1/claim.schema.json",
  "title": "Canonical research claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "statementId",
    "targetClauseIds",
    "relation",
    "title",
    "text"
  ],
  "properties": {
    "kind": { "const": "Claim" },
    "id": { "type": "string", "minLength": 1 },
    "statementId": { "type": "string", "minLength": 1 },
    "targetClauseIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "relation": {
      "enum": [
        "supports",
        "narrows",
        "refutes",
        "resolves",
        "reformulates",
        "rules-out",
        "status-review"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 }
  }
}
