{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naixu-guo.github.io/quantum-open-problems/schema/canonical/v0.1/decision.schema.json",
  "title": "Canonical editorial decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "problemId",
    "statementId",
    "decisionType",
    "outcome",
    "supersedesDecisionId",
    "status",
    "effectiveDate",
    "verified",
    "evidenceIds",
    "rationale"
  ],
  "properties": {
    "kind": { "const": "Decision" },
    "id": { "type": "string", "minLength": 1 },
    "problemId": { "type": "string", "minLength": 1 },
    "statementId": { "type": "string", "minLength": 1 },
    "decisionType": { "const": "status-assessment" },
    "outcome": { "enum": ["accepted", "rejected"] },
    "supersedesDecisionId": { "type": ["string", "null"] },
    "status": { "enum": ["open", "partial", "solved"] },
    "effectiveDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "verified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "evidenceIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "rationale": { "type": "string", "minLength": 1 }
  }
}
