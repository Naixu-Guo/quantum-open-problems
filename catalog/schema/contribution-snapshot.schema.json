{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naixu-guo.github.io/quantum-open-problems/schema/canonical/v0.2/contribution-snapshot.schema.json",
  "title": "Promoted contribution snapshot",
  "description": "Frozen copy of an accepted candidate update and its reviews, stored under catalog/problems/<id>/contributions/ when the update is promoted into canonical Claim, Evidence, or Decision objects. Makes the promotion auditable inside Git.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "candidateUpdate", "reviews", "promotedObjectIds", "promotedOn", "promotedByActorId"],
  "properties": {
    "kind": { "const": "qop-contribution-snapshot" },
    "schemaVersion": { "const": "1.0.0" },
    "candidateUpdate": {
      "type": "object",
      "required": ["id", "problemId", "statementId", "targetClauseIds", "updateKind", "title", "claim", "scope", "sources", "artifacts", "proposedEffect", "remainingGap", "submittedBy", "submittedAt", "reviewState"],
      "properties": {
        "id": { "type": "string", "pattern": "^cu-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "problemId": { "type": "string" },
        "statementId": { "type": "string" },
        "targetClauseIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "updateKind": { "type": "string" },
        "title": { "type": "string" },
        "claim": { "type": "string" },
        "scope": { "type": "string" },
        "sources": { "type": "array" },
        "artifacts": { "type": "array" },
        "proposedEffect": { "type": "object" },
        "remainingGap": { "type": "string" },
        "submittedBy": { "$ref": "actor.schema.json" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "reviewState": { "enum": ["accepted", "promoted"] }
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "candidateUpdateId", "reviewType", "verdict", "summary", "reviewer", "createdAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^rev-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "candidateUpdateId": { "type": "string" },
          "reviewType": { "enum": ["scope", "source", "argument", "artifact", "reproduction", "editorial"] },
          "verdict": { "enum": ["accept", "reject", "needs-revision", "inconclusive"] },
          "summary": { "type": "string" },
          "reviewer": { "$ref": "actor.schema.json" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "promotedObjectIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "promotedOn": { "type": "string", "format": "date" },
    "promotedByActorId": { "type": "string", "pattern": "^actor-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "serviceEventSequence": { "type": ["integer", "null"], "minimum": 1 }
  }
}
