{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naixu-guo.github.io/quantum-open-problems/contract/v1/decision.schema.json",
  "title": "Decision",
  "description": "A policy-driven state transition. Immutable. The only source of state.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/immutableBase" }],
  "unevaluatedProperties": false,
  "required": ["type", "kind", "targetType", "targetId", "mergeIntoProblemId", "outcome", "status", "verificationLevel", "reviewIds", "contributionIds", "policyVersion", "effectiveAt", "body"],
  "properties": {
    "type": { "const": "Decision" },
    "kind": { "enum": ["admission", "promotion", "acceptance", "withdrawal", "status", "merge", "retire", "moderation", "redaction", "maintenance", "release"] },
    "targetType": { "enum": ["problem", "contribution", "comment", "statement", "claim", "reference", "trajectory", "review", "source", "artifact", "ledger"] },
    "targetId": { "type": "string", "minLength": 1 },
    "mergeIntoProblemId": { "$ref": "common.schema.json#/$defs/ulidOrNull" },
    "outcome": { "enum": ["accepted", "rejected"] },
    "status": { "enum": ["open", "partial", "solved", "refuted", null] },
    "verificationLevel": { "enum": ["unreviewed", "reviewed", "triaged", "ai-verified", "machine-verified", "human-signed", null] },
    "reviewIds": { "$ref": "common.schema.json#/$defs/ulidList" },
    "contributionIds": { "$ref": "common.schema.json#/$defs/ulidList" },
    "policyVersion": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
    "effectiveAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "body": { "$ref": "common.schema.json#/$defs/nonEmptyText" }
  }
}
