{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naixu-guo.github.io/quantum-open-problems/contract/v1/statement.schema.json",
  "title": "Statement",
  "description": "One immutable formulation of a problem, with its clauses embedded. The digest covers the normalized body.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/immutableBase" }],
  "unevaluatedProperties": false,
  "required": ["type", "problemId", "version", "digest", "clauses", "body"],
  "properties": {
    "type": { "const": "Statement" },
    "problemId": { "$ref": "common.schema.json#/$defs/ulid" },
    "version": { "type": "integer", "minimum": 1 },
    "digest": { "$ref": "common.schema.json#/$defs/digest" },
    "clauses": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/clause" } },
    "body": { "$ref": "common.schema.json#/$defs/nonEmptyText" }
  }
}
