{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naixu-guo.github.io/quantum-open-problems/contract/v1/comment.schema.json",
  "title": "Comment",
  "description": "Discussion attached to one record. Revisable. Moderation is a decision, not a field. Never cited by a status decision.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/revisableBase" }],
  "unevaluatedProperties": false,
  "required": ["type", "targetType", "targetId", "parentCommentId", "promotedToContributionId", "body"],
  "properties": {
    "type": { "const": "Comment" },
    "targetType": { "enum": ["problem", "statement", "clause", "claim", "reference", "contribution", "trajectory", "review"] },
    "targetId": { "type": "string", "minLength": 1 },
    "parentCommentId": { "$ref": "common.schema.json#/$defs/ulidOrNull" },
    "promotedToContributionId": { "$ref": "common.schema.json#/$defs/ulidOrNull" },
    "body": { "$ref": "common.schema.json#/$defs/nonEmptyText" }
  }
}
